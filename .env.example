# Supabase project URL (Project settings > API). Read by the browser, server and middleware.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Safe for the browser, access is limited by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Server only, bypasses RLS. Used by register, profile and payment routes.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app, no trailing slash. Used for payment redirects and QR ticket links.
NEXT_PUBLIC_APP_URL=
# Base URL for password reset links. Optional, falls back to the request origin.
NEXT_PUBLIC_SITE_URL=

# Stripe secret key (sk_...). lib/stripe.ts throws at import time if it is missing.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...) for POST /api/payments/webhook.
STRIPE_WEBHOOK_SECRET=

# Paymob API key. Only read by lib/paymob.ts, which no route calls yet.
PAYMOB_API_KEY=
# Paymob card iframe id, used to build the hosted card form URL.
PAYMOB_IFRAME_ID=
# Paymob HMAC secret for verifying Paymob callbacks.
PAYMOB_HMAC_SECRET=
